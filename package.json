{
  "name": "fontiny",
  "version": "0.2.0",
  "description": "A Node.js SDK and CLI for font subsetting, conversion, and iconfont generation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fontiny": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./iconfont": {
      "types": "./dist/iconfont/index.d.ts",
      "import": "./dist/iconfont/index.js",
      "require": "./dist/iconfont/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "font",
    "subset",
    "woff",
    "woff2",
    "iconfont",
    "cli"
  ],
  "author": "vhhgx",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "fonteditor-core": "^2.6.3",
    "fs-extra": "^11.3.2",
    "picocolors": "^1.1.1",
    "svgtofont": "^6.0.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
